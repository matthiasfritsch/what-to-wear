# Kopieren nach .env und anpassen. Die Datei .env landet nie im Repo.

# Port, unter dem die App auf dem Rechner erreichbar ist
APP_PORT=3000

# Zeitzone für "Heute" und das Wetter
TZ=Europe/Berlin

# Namen der Haushaltsmitglieder, die beim allerersten Start angelegt werden
SEED_MEMBERS=Matthias,Lisa

# Kommt in Schritt 2 und 4 (KI-Tagging und Vorschläge), noch nicht nötig:
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=
# AI_MODEL=google/gemini-2.5-flash
